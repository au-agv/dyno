environment,
    results_output
        results_output_file 'case'
        hdf5

method,
    vector_parameter_study
        step_vector 0.51
        num_steps 1

variables,
    continuous_design 1
        descriptors   'rate'
        lower_bounds  +5.0
        initial_point +10.1
        upper_bounds  +35.0

interface,
    analysis_drivers './analysis_driver.sh'
        input_filter './input_filter.sh {PARAMETERS}'
        output_filter './output_filter.sh {PARAMETERS} {RESULTS}'
        fork
            parameters_file 'parameters.json'
            results_file 'results.json'
            parameters_format
                json
            results_format
                json
            file_save
            work_directory
                named 'runs/run'
                directory_tag
                directory_save
                link_files 'bin/case.py'
                           'bin/analysis_driver.sh'
                           'bin/input_filter.sh'
                           'bin/output_filter.sh'
                           'include/python_includes.py'
                           'include/case.tpl.json'
                           'include/overrides.tpl.yaml'
                replace
            verbatim
    asynchronous
        evaluation_concurrency 1

responses,
    response_functions 1
    descriptors 'average_speed'
    no_gradients
    no_hessians
